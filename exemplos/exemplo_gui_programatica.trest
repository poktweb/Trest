# Exemplo de Interface Gráfica Programática (estilo PySide6)
# Demonstra como criar interfaces GUI via código, sem depender de HTML manual

импорт * как GUI измодуля "std/gui"

печать("🖥️  Criando aplicativo com interface gráfica programática...")
печать("")

# Criar janela programática (sem HTML manual)
пусть janela = GUI.criarJanelaProgramática({
    título = "Calculadora - GUI Programática",
    largura = 400,
    altura = 500,
    redimensionável = истина,
    centralizar = истина
})

# Criar widgets programaticamente (estilo PySide6)
# Nota: Por enquanto, os estilos são aplicados automaticamente
# Futuramente, poderemos adicionar métodos setStyle() aos widgets
пусть labelTitulo = GUI.Label("Calculadora")
пусть inputNumero1 = GUI.Input("Primeiro número")
пусть inputNumero2 = GUI.Input("Segundo número")
пусть labelResultado = GUI.Label("Resultado: 0")

# Criar botões para operações
# Por enquanto, vamos criar botões simples sem callbacks
# (os callbacks serão implementados em uma versão futura)
пусть botaoSomar = GUI.Button("+", нуль)
пусть botaoSubtrair = GUI.Button("-", нуль)
пусть botaoMultiplicar = GUI.Button("×", нуль)
пусть botaoDividir = GUI.Button("÷", нуль)

# Botões já criados acima

# Criar layouts programaticamente (estilo PySide6)
# VBox = Layout vertical
пусть vbox = GUI.VBox([], 10)  # spacing = 10px

# Adicionar widgets ao VBox
vbox.children.push(labelTitulo)
vbox.children.push(inputNumero1)
vbox.children.push(inputNumero2)
vbox.children.push(labelResultado)

# HBox = Layout horizontal (para botões)
пусть hboxLinha1 = GUI.HBox([botaoSomar, botaoSubtrair], 5)
пусть hboxLinha2 = GUI.HBox([botaoMultiplicar, botaoDividir], 5)

# Adicionar botões ao VBox
vbox.children.push(hboxLinha1)
vbox.children.push(hboxLinha2)

# Definir layout na janela
janela.setLayout(vbox)

# Mostrar janela
janela.show()

# Manter aplicação rodando
GUI.manterRodando()

печать("✅ Aplicativo iniciado com sucesso!")
печать("💡 Feche a janela para sair da aplicação.")
