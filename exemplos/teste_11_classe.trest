# Teste 11: Classes
# Testa declaração e uso de classes

печать("=== Teste 11: Classes ===")

# Classe simples (conforme documentação)
класс Pessoa {
    функция конструктор(nome, idade) {
        это.nome = nome
        это.idade = idade
    }
    
    функция apresentar() {
        печать("Olá, sou " + это.nome + " e tenho " + это.idade + " anos")
    }
    
    функция fazerAniversario() {
        это.idade = это.idade + 1
    }
}

пусть pessoa1 = новый Pessoa("Ana", 30)
pessoa1.apresentar()
pessoa1.fazerAniversario()
печать("Nova idade: " + pessoa1.idade)

печать("✅ Teste 11: Classes - PASSOU")
