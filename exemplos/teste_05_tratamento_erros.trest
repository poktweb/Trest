# Teste 5: Tratamento de Erros
# Testa try/catch/finally

печать("=== Teste 5: Tratamento de Erros ===")

# Teste try/catch
печать("Teste try/catch:")
попытаться {
    пусть resultado = 10 / 0
    печать("Resultado: " + resultado)
} перехватить (erro) {
    печать("Erro capturado: " + erro)
}

# Teste try/catch/finally
печать("Teste try/catch/finally:")
попытаться {
    печать("Executando código normal")
    печать("Tudo OK")
} перехватить (erro) {
    печать("Erro: " + erro)
} наконец {
    печать("Bloco finally sempre executa")
}

# Teste throw
печать("Teste throw:")
функция validarIdade(idade) {
    если (idade < 0) {
        бросить "Idade não pode ser negativa"
    }
    вернуть истина
}

попытаться {
    validarIdade(-5)
} перехватить (erro) {
    печать("Erro lançado: " + erro)
}

печать("✅ Teste 5: Tratamento de Erros - PASSOU")
