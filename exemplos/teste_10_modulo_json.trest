# Teste 10: Módulo JSON
# Testa serialização e desserialização JSON

импорт * как JSON измодуля "std/json"

печать("=== Teste 10: Módulo JSON ===")

# Teste parse (string para objeto) - conforme documentação
пусть jsonString = '{"имя": "Иван"}'
пусть obj = JSON.parse(jsonString)
печать("Имя: " + obj.имя)

# Teste stringify (objeto para string) - conforme documentação
пусть pessoa = { имя = "Иван" }
пусть str = JSON.stringify(pessoa)
печать("JSON stringificado: " + str)

печать("✅ Teste 10: Módulo JSON - PASSOU")
