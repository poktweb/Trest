# 🌐 Site Web em Trest
# Um exemplo completo de site web usando o módulo HTTP

импорт * как HTTP измодуля "std/http"

печать("🚀 Iniciando servidor web Trest...")
печать("")

# Configuração do servidor
пусть PORTA = 3000
пусть HOST = "localhost"

# HTML da página inicial - usando concatenação de strings
функция obterHTMLInicial() {
    вернуть "<!DOCTYPE html>\n" +
"<html lang=\"pt-BR\">\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
"    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n" +
"    <title>Trest Language - Site Web</title>\n" +
"    <style>\n" +
"        * { margin: 0; padding: 0; box-sizing: border-box; }\n" +
"        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }\n" +
"        .container { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; max-width: 600px; width: 100%; }\n" +
"        h1 { color: #667eea; margin-bottom: 20px; font-size: 2.5em; text-align: center; }\n" +
"        .subtitle { color: #666; text-align: center; margin-bottom: 30px; font-size: 1.2em; }\n" +
"        .feature { background: #f8f9fa; border-left: 4px solid #667eea; padding: 15px; margin: 15px 0; border-radius: 5px; }\n" +
"        .feature h3 { color: #333; margin-bottom: 8px; }\n" +
"        .feature p { color: #666; line-height: 1.6; }\n" +
"        .button { display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 12px 30px; border-radius: 25px; text-decoration: none; margin: 10px; transition: transform 0.3s; }\n" +
"        .button:hover { transform: translateY(-2px); }\n" +
"        .footer { text-align: center; margin-top: 30px; color: #999; font-size: 0.9em; }\n" +
"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <div class=\"container\">\n" +
"        <h1>🚀 Trest Language</h1>\n" +
"        <p class=\"subtitle\">Linguagem de Programação Moderna com Suporte a Cirílico</p>\n" +
"        <div class=\"feature\">\n" +
"            <h3>✅ Suporte Total ao Cirílico</h3>\n" +
"            <p>Programe usando palavras-chave em russo nativas, mantendo a mesma sintaxe e funcionalidades.</p>\n" +
"        </div>\n" +
"        <div class=\"feature\">\n" +
"            <h3>🌐 Compilação Universal</h3>\n" +
"            <p>Compile para Web (JavaScript) e Desktop (.exe) com o mesmo código.</p>\n" +
"        </div>\n" +
"        <div class=\"feature\">\n" +
"            <h3>📚 Biblioteca Padrão Rica</h3>\n" +
"            <p>15+ módulos prontos para usar: HTTP, FileSystem, Crypto, Database e muito mais.</p>\n" +
"        </div>\n" +
"        <div style=\"text-align: center; margin-top: 30px;\">\n" +
"            <a href=\"/sobre\" class=\"button\">Sobre</a>\n" +
"            <a href=\"/api\" class=\"button\">API</a>\n" +
"            <a href=\"/contato\" class=\"button\">Contato</a>\n" +
"        </div>\n" +
"        <div class=\"footer\">\n" +
"            <p>Versão 2.4.6 • Feito com ❤️ usando Trest Language</p>\n" +
"        </div>\n" +
"    </div>\n" +
"</body>\n" +
"</html>"
}

# HTML da página Sobre
функция obterHTMLSobre() {
    вернуть "<!DOCTYPE html>\n" +
"<html lang=\"pt-BR\">\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
"    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n" +
"    <title>Sobre - Trest Language</title>\n" +
"    <style>\n" +
"        * { margin: 0; padding: 0; box-sizing: border-box; }\n" +
"        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 40px 20px; }\n" +
"        .container { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; max-width: 800px; margin: 0 auto; }\n" +
"        h1 { color: #667eea; margin-bottom: 10px; font-size: 2.5em; }\n" +
"        .back-link { display: inline-block; color: #667eea; text-decoration: none; margin-bottom: 30px; font-weight: bold; }\n" +
"        .back-link:hover { text-decoration: underline; }\n" +
"        p { color: #666; line-height: 1.8; margin-bottom: 20px; font-size: 1.1em; }\n" +
"        .code-block { background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 5px; padding: 15px; margin: 20px 0; font-family: 'Courier New', monospace; overflow-x: auto; }\n" +
"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <div class=\"container\">\n" +
"        <a href=\"/\" class=\"back-link\">← Voltar</a>\n" +
"        <h1>📖 Sobre Trest</h1>\n" +
"        <p><strong>Trest</strong> é uma linguagem de programação moderna que permite programar usando palavras-chave em <strong>cirílico</strong> (alfabeto russo) ou latino, mantendo a mesma sintaxe e funcionalidades.</p>\n" +
"        <p>Desenvolvida para oferecer <strong>zero barreira linguística</strong> para falantes de russo, Trest combina a familiaridade do JavaScript/TypeScript com a flexibilidade de programar em múltiplos idiomas.</p>\n" +
"        <h2 style=\"color: #667eea; margin-top: 30px; margin-bottom: 15px;\">Características Principais</h2>\n" +
"        <ul style=\"color: #666; line-height: 2; margin-left: 20px;\">\n" +
"            <li>✅ <strong>Suporte Total ao Cirílico</strong> - Palavras-chave em russo nativas</li>\n" +
"            <li>✅ <strong>Tipagem Dinâmica</strong> - Tipos inferidos automaticamente</li>\n" +
"            <li>✅ <strong>Compilação Universal</strong> - Para Web (JavaScript) e Desktop (.exe)</li>\n" +
"            <li>✅ <strong>Biblioteca Padrão Rica</strong> - 15+ módulos prontos para usar</li>\n" +
"            <li>✅ <strong>Sistema de Módulos</strong> - Import/Export completo</li>\n" +
"        </ul>\n" +
"        <h2 style=\"color: #667eea; margin-top: 30px; margin-bottom: 15px;\">Exemplo de Código</h2>\n" +
"        <div class=\"code-block\">\n" +
"печать(\"Привет, Мир!\")<br>\n" +
"пусть имя = \"Trest\"<br>\n" +
"печать(\"Привет, \" + имя)\n" +
"        </div>\n" +
"        <p style=\"margin-top: 30px; text-align: center; color: #999;\">Para mais informações, visite nossa documentação completa.</p>\n" +
"    </div>\n" +
"</body>\n" +
"</html>"
}

# HTML da página API
функция obterHTMLAPI() {
    вернуть "<!DOCTYPE html>\n" +
"<html lang=\"pt-BR\">\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
"    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n" +
"    <title>API - Trest Language</title>\n" +
"    <style>\n" +
"        * { margin: 0; padding: 0; box-sizing: border-box; }\n" +
"        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 40px 20px; }\n" +
"        .container { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; max-width: 900px; margin: 0 auto; }\n" +
"        h1 { color: #667eea; margin-bottom: 10px; font-size: 2.5em; }\n" +
"        .back-link { display: inline-block; color: #667eea; text-decoration: none; margin-bottom: 30px; font-weight: bold; }\n" +
"        .api-endpoint { background: #f8f9fa; border-left: 4px solid #667eea; padding: 20px; margin: 20px 0; border-radius: 5px; }\n" +
"        .method { display: inline-block; background: #667eea; color: white; padding: 5px 15px; border-radius: 5px; font-weight: bold; margin-right: 10px; }\n" +
"        .endpoint { font-family: 'Courier New', monospace; font-size: 1.1em; color: #333; }\n" +
"        .description { color: #666; margin-top: 10px; line-height: 1.6; }\n" +
"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <div class=\"container\">\n" +
"        <a href=\"/\" class=\"back-link\">← Voltar</a>\n" +
"        <h1>🔌 API REST</h1>\n" +
"        <div class=\"api-endpoint\"><span class=\"method\">GET</span><span class=\"endpoint\">/</span><div class=\"description\">Retorna a página inicial do site</div></div>\n" +
"        <div class=\"api-endpoint\"><span class=\"method\">GET</span><span class=\"endpoint\">/sobre</span><div class=\"description\">Retorna informações sobre a linguagem Trest</div></div>\n" +
"        <div class=\"api-endpoint\"><span class=\"method\">GET</span><span class=\"endpoint\">/api</span><div class=\"description\">Retorna esta página de documentação da API</div></div>\n" +
"        <div class=\"api-endpoint\"><span class=\"method\">GET</span><span class=\"endpoint\">/api/usuarios</span><div class=\"description\">Retorna lista de usuários em formato JSON</div></div>\n" +
"        <div class=\"api-endpoint\"><span class=\"method\">GET</span><span class=\"endpoint\">/api/status</span><div class=\"description\">Retorna status do servidor em formato JSON</div></div>\n" +
"    </div>\n" +
"</body>\n" +
"</html>"
}

# HTML da página Contato
функция obterHTMLContato() {
    вернуть "<!DOCTYPE html>\n" +
"<html lang=\"pt-BR\">\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
"    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n" +
"    <title>Contato - Trest Language</title>\n" +
"    <style>\n" +
"        * { margin: 0; padding: 0; box-sizing: border-box; }\n" +
"        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 40px 20px; }\n" +
"        .container { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; max-width: 600px; margin: 0 auto; }\n" +
"        h1 { color: #667eea; margin-bottom: 10px; font-size: 2.5em; }\n" +
"        .back-link { display: inline-block; color: #667eea; text-decoration: none; margin-bottom: 30px; font-weight: bold; }\n" +
"        .contact-info { background: #f8f9fa; padding: 20px; border-radius: 10px; margin: 20px 0; }\n" +
"        .contact-info h3 { color: #667eea; margin-bottom: 10px; }\n" +
"        .contact-info p { color: #666; line-height: 1.8; }\n" +
"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <div class=\"container\">\n" +
"        <a href=\"/\" class=\"back-link\">← Voltar</a>\n" +
"        <h1>📧 Contato</h1>\n" +
"        <div class=\"contact-info\"><h3>🌐 Site Oficial</h3><p>https://trest-site.vercel.app</p></div>\n" +
"        <div class=\"contact-info\"><h3>📦 npm Package</h3><p>https://www.npmjs.com/package/treste</p></div>\n" +
"        <div class=\"contact-info\"><h3>📚 Documentação</h3><p>Consulte o arquivo DOCUMENTACAO_COMPLETA.md para informações detalhadas sobre a linguagem Trest.</p></div>\n" +
"        <div class=\"contact-info\"><h3>💡 Suporte</h3><p>Para questões ou sugestões, visite o site oficial do projeto.</p></div>\n" +
"    </div>\n" +
"</body>\n" +
"</html>"
}

# HTML da página 404
функция obterHTML404() {
    вернуть "<!DOCTYPE html>\n" +
"<html>\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
"    <title>404 - Não Encontrado</title>\n" +
"    <style>\n" +
"        body { font-family: Arial, sans-serif; text-align: center; padding: 50px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }\n" +
"        h1 { font-size: 4em; margin: 20px 0; }\n" +
"        p { font-size: 1.2em; }\n" +
"        a { color: white; text-decoration: underline; }\n" +
"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <h1>404</h1>\n" +
"    <p>Página não encontrada</p>\n" +
"    <a href=\"/\">← Voltar para a página inicial</a>\n" +
"</body>\n" +
"</html>"
}

# Criar servidor HTTP
пусть servidor = HTTP.создатьСервер()

# Rota principal - Página inicial
servidor.get("/", функция(запрос, ответ) {
    печать("📄 Requisição: GET /")
    ответ.status(200)
    ответ.send(obterHTMLInicial())
})

# Rota Sobre
servidor.get("/sobre", функция(запрос, ответ) {
    печать("📄 Requisição: GET /sobre")
    ответ.status(200)
    ответ.send(obterHTMLSobre())
})

# Rota API (documentação)
servidor.get("/api", функция(запрос, ответ) {
    печать("📄 Requisição: GET /api")
    ответ.status(200)
    ответ.send(obterHTMLAPI())
})

# Rota Contato
servidor.get("/contato", функция(запрос, ответ) {
    печать("📄 Requisição: GET /contato")
    ответ.status(200)
    ответ.send(obterHTMLContato())
})

# API JSON - Lista de usuários
servidor.get("/api/usuarios", функция(запрос, ответ) {
    печать("📄 Requisição: GET /api/usuarios")
    пусть usuarios = [
        { id = 1, nome = "Иван", idade = 30, cidade = "Москва" },
        { id = 2, nome = "Мария", idade = 25, cidade = "Санкт-Петербург" },
        { id = 3, nome = "Петр", idade = 35, cidade = "Новосибирск" }
    ]
    ответ.json(usuarios)
})

# API JSON - Status do servidor
servidor.get("/api/status", функция(запрос, ответ) {
    печать("📄 Requisição: GET /api/status")
    пусть status = {
        servidor = "Trest Language Web Server",
        versao = "2.4.6",
        status = "online",
        porta = PORTA,
        timestamp = Date.now()
    }
    ответ.json(status)
})

# Rota 404 - Página não encontrada (deve ser a última rota)
# Nota: A rota "*" precisa ser implementada no servidor para capturar todas as outras rotas
# Por enquanto, vamos criar uma rota específica para testar
servidor.get("/404", функция(запрос, ответ) {
    печать("❌ Requisição não encontrada: " + запрос.url)
    ответ.status(404)
    ответ.send(obterHTML404())
})

# Iniciar servidor
servidor.listen(PORTA, функция() {
    печать("")
    печать("✅ Servidor web iniciado com sucesso!")
    печать("")
    печать("🌐 Acesse: http://" + HOST + ":" + PORTA)
    печать("")
    печать("📋 Rotas disponíveis:")
    печать("   • GET  /              - Página inicial")
    печать("   • GET  /sobre         - Sobre o Trest")
    печать("   • GET  /api           - Documentação da API")
    печать("   • GET  /contato       - Página de contato")
    печать("   • GET  /api/usuarios  - API: Lista de usuários (JSON)")
    печать("   • GET  /api/status    - API: Status do servidor (JSON)")
    печать("")
    печать("💡 Pressione Ctrl+C para parar o servidor")
    печать("")
})
