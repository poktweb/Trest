# Teste 1: Variáveis
# Testa declaração de variáveis com diferentes tipos

печать("=== Teste 1: Variáveis ===")

# Testar перем (var)
перем имя = "Trest"
печать("Имя: " + имя)

# Testar пусть (let)
пусть возраст = 25
печать("Возраст: " + возраст)

# Testar конст (const)
конст pi = 3.14159
печать("PI: " + pi)

печать("✅ Teste 1: Variáveis - PASSOU")
