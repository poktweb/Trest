# Demonstração HTTP - Simples

печать("╔═══════════════════════════════════════╗")
печать("║   🌐 HTTP DEMO                        ║")
печать("╚═══════════════════════════════════════╝")
печать("")

# Importar módulo HTTP
импорт * как HTTP измодуля "std/index"

печать("📝 Criando servidor HTTP local...")

пусть server = HTTP.создатьСервер()

server.получить("/", (req, res) => {
    печать("📍 Requisição recebida!")
    res.status(200).send("Olá do Trest!")
})

server.слушать(8080, () => {
    печать("✅ Servidor rodando em http://localhost:8080")
    печать("Abra o navegador e teste!")
})

