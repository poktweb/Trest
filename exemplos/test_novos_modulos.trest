# Teste dos Novos Módulos v2.3.0

печать("╔═══════════════════════════════════════════════════════════════╗")
печать("║   🎉 TREST v2.3.0 - NOVOS MÓДУЛИ                             ║")
печать("╚═══════════════════════════════════════════════════════════════╝")
печать("")

# RegEx
печать("🔍 RegEx Module:")
пусть texto = "Email: usuario@example.com"
если (RegEx.тест("@example.com", texto)) {
    печать("  ✅ Email válido")
}
печать("")

# Path  
печать("📁 Path Module:")
пусть caminho = Path.соединить("src", "main.trest")
печать("  Join:", caminho)
печать("  Dirname:", Path.директория("/usr/bin/file.js"))
печать("  Basename:", Path.базовоеИмя("/usr/bin/file.js"))
печать("  Extension:", Path.расширение("/usr/bin/file.js"))
печать("  Is Absolute:", Path.абсолютный("/usr/bin"))
печать("")

# Process
печать("⚙️  Process Module:")
печать("  Plataforma:", Process.платформа)
печать("  Arquitetura:", Process.архитектура)
печать("  Versão Node:", Process.версия)
печать("  PID:", Process.pid)
печать("")

печать("✅ RegEx, Path e Process funcionando!")
