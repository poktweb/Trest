# Teste Completo Todos os Módulos 2.3.0

печать("╔═══════════════════════════════════════════════════════════════╗")
печать("║   🎉 TREST v2.3.0 - TODOS OS MÓДУЛИ FUNCIONAIS               ║")
печать("╚═══════════════════════════════════════════════════════════════╝")
печать("")

# Math
импорт * как Math измодуля "std/math"
печать("🔢 Math:")
печать("  sqrt(25) =", Math.sqrt(25))
печать("  max(10, 20) =", Math.max(10, 20))
печать("")

# Crypto
импорт * как Crypto измодуля "std/crypto"
печать("🔐 Crypto:")
печать("  MD5('test') =", Crypto.md5("test"))
печать("")

# FileSystem
импорт * как FileSystem измодуля "std/filesystem"
печать("📁 FileSystem:")
печать("  package.json existe:", FileSystem.существует("package.json"))
печать("")

# JSON
импорт * как JSON измодуля "std/json"
печать("📄 JSON:")
пусть obj = { nome = "PoktWeb", lang = "Trest" }
печать("  Object:", obj)
печать("")

# Date
импорт * как Date измодуля "std/date"
печать("📅 Date:")
печать("  Timezone:", Date.timezone())
печать("")

# HTTP
импорт * как HTTP измодуля "std/http"
печать("🌐 HTTP:")
печать("  HTTP module disponível ✅")
печать("")

# RegEx
импорт * как RegEx измодуля "std/regex"
печать("🔍 RegEx:")
пусть texto = "usuario@example.com"
если (RegEx.тест("@example.com", texto)) {
    печать("  Email válido ✅")
}
печать("")

# Path
импорт * как Path измодуля "std/path"
печать("📁 Path:")
пусть caminho = Path.соединить("src", "main.trest")
печать("  Join:", caminho)
печать("  Basename:", Path.базовоеИмя("/usr/bin/file.js"))
печать("  Extension:", Path.расширение("/usr/bin/file.js"))
печать("")

# Process
импорт * как Process измодуля "std/process"
печать("⚙️  Process:")
печать("  Platform:", Process.платформа)
печать("  PID:", Process.pid)
печать("  Node:", Process.версия)
печать("")

печать("╔═══════════════════════════════════════════════════════════════╗")
печать("║   ✅ 11 MÓДУЛИ FUNCIONANDO PERFEITAMENTE!                    ║")
