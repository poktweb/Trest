"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <!-- Menu Lateral -->\n" +
"    <aside class=\"sidebar\">\n" +
"        <div class=\"sidebar-header\">\n" +
"            <h1>🚀 Trest</h1>\n" +
"            <p>v2.4.9</p>\n" +
"        </div>\n" +
"        <nav>\n" +
"            <ul class=\"nav-menu\">\n" +
"                <li><a href=\"#inicio\">Início</a></li>\n" +
"                <li><a href=\"#sobre\">Sobre</a></li>\n" +
"                <li><a href=\"#pontos-fortes\">Pontos Fortes</a></li>\n" +
"                <li><a href=\"#caracteristicas\">Características</a></li>\n" +
"                <li><a href=\"#exemplos\">Exemplos</a></li>\n" +
"                <li><a href=\"#biblioteca\">Biblioteca Padrão</a></li>\n" +
"                <li><a href=\"#links\">Links Úteis</a></li>\n" +
"            </ul>\n" +
"        </nav>\n" +
"    </aside>\n" +
"\n" +
"    <!-- Conteúdo Principal -->\n" +
"    <main class=\"main-content\">\n" +
"        <section id=\"inicio\">\n" +
"            <h1>Trest Language</h1>\n" +
"            <p class=\"intro\">\n" +
"                Linguagem de programação moderna e profissional com suporte completo a cirílico.\n" +
"                Permite programar usando palavras-chave em russo ou latino, mantendo a mesma sintaxe e funcionalidades.\n" +
"            </p>\n" +
"            <p>\n" +
"                Trest compila para Web (JavaScript) e Desktop (.exe), oferecendo uma biblioteca padrão rica\n" +
"                e um sistema de módulos completo. Zero barreira linguística para falantes de russo.\n" +
"            </p>\n" +
"        </section>\n" +
"\n" +
"        <section id=\"sobre\">\n" +
"            <h2>Sobre Trest</h2>\n" +
"            <p>\n" +
"                Trest é uma linguagem de programação criada para ser moderna, intuitiva e poderosa.\n" +
"                Sua principal característica é o suporte nativo ao alfabeto cirílico, permitindo que\n" +
"                programadores russos escrevam código usando palavras-chave em seu idioma nativo.\n" +
"            </p>\n" +
"            <p>\n" +
"                Desenvolvida com foco em produtividade, Trest oferece uma sintaxe limpa baseada em\n" +
"                JavaScript/TypeScript, mas com recursos únicos que a tornam especial. O mesmo código\n" +
"                pode ser compilado para diferentes plataformas sem modificações.\n" +
"            </p>\n" +
"            <div class=\"code-block\">\n" +
"                <code>печать(\"Привет, Мир!\")</code>\n" +
"            </div>\n" +
"        </section>\n" +
"\n" +
"        <section id=\"pontos-fortes\">\n" +
"            <h2>Pontos Fortes</h2>\n" +
"            <div class=\"feature-grid\">\n" +
"                <div class=\"feature-card\">\n" +
"                    <h3>🌐 Suporte Total ao Cirílico</h3>\n" +
"                    <p>Palavras-chave em russo nativas, permitindo programação completamente em cirílico.</p>\n" +
"                </div>\n" +
"                <div class=\"feature-card\">\n" +
"                    <h3>⚡ Compilação Universal</h3>\n" +
"                    <p>Compila para Web (JavaScript) e Desktop (.exe) a partir do mesmo código fonte.</p>\n" +
"                </div>\n" +
"                <div class=\"feature-card\">\n" +
"                    <h3>📚 Biblioteca Padrão Rica</h3>\n" +
"                    <p>15+ módulos prontos para usar: HTTP, Crypto, FileSystem, Database e mais.</p>\n" +
"                </div>\n" +
"                <div class=\"feature-card\">\n" +
"                    <h3>🔧 Tipagem Dinâmica</h3>\n" +
"                    <p>Tipos inferidos automaticamente, tornando o desenvolvimento mais ágil.</p>\n" +
"                </div>\n" +
"                <div class=\"feature-card\">\n" +
"                    <h3>📦 Sistema de Módulos</h3>\n" +
"                    <p>Import/Export completo para organizar código em múltiplos arquivos.</p>\n" +
"                </div>\n" +
"                <div class=\"feature-card\">\n" +
"                    <h3>🛡️ Tratamento de Erros</h3>\n" +
"                    <p>Try/Catch/Throw robusto com mensagens claras de erro.</p>\n" +
"                </div>\n" +
"            </div>\n" +
"        </section>\n" +
"\n" +
"        <section id=\"caracteristicas\">\n" +
"            <h2>Características Principais</h2>\n" +
"            <ul>\n" +
"                <li><strong>Execução Inline:</strong> Execute código direto na linha de comando com <code>-e</code></li>\n" +
"                <li><strong>Compilação para Web:</strong> Gera JavaScript otimizado para navegadores e Node.js</li>\n" +
"                <li><strong>Compilação para Desktop:</strong> Cria executáveis .exe nativos standalone</li>\n" +
"                <li><strong>Sintaxe Intuitiva:</strong> Baseada em JavaScript/TypeScript, fácil de aprender</li>\n" +
"                <li><strong>Zero Configuração:</strong> Funciona imediatamente após instalação</li>\n" +
"                <li><strong>Desenvolvimento Ativo:</strong> Versão 2.4.9 com melhorias constantes</li>\n" +
"            </ul>\n" +
"        </section>\n" +
"\n" +
"        <section id=\"exemplos\">\n" +
"            <h2>Exemplos de Código</h2>\n" +
"\n" +
"            <h3>Variáveis e Funções</h3>\n" +
"            <div class=\"code-block\">\n" +
"                <code>пусть имя = \"Trest\"<br>" +
"пусть возраст = 25<br><br>" +
"функция приветствие(имя) {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;вернуть \"Привет, \" + имя<br>" +
"}<br><br>" +
"печать(приветствие(\"Мир\"))</code>\n" +
"            </div>\n" +
"\n" +
"            <h3>Condicionais e Loops</h3>\n" +
"            <div class=\"code-block\">\n" +
"                <code>если (возраст >= 18) {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;печать(\"Совершеннолетний\")<br>" +
"} иначе {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;печать(\"Ребенок\")<br>" +
"}<br><br>" +
"для (пусть i = 0; i < 10; i = i + 1) {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;печать(i)<br>" +
"}</code>\n" +
"            </div>\n" +
"\n" +
"            <h3>Servidor HTTP</h3>\n" +
"            <div class=\"code-block\">\n" +
"                <code>импорт * как HTTP измодуля \"std/http\"<br><br>" +
"пусть servidor = HTTP.создатьСервер()<br><br>" +
"servidor.get(\"/\", функция(запрос, ответ) {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;ответ.send(\"<h1>Olá do Trest!</h1>\")<br>" +
"})<br><br>" +
"servidor.listen(3000, функция() {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;печать(\"✅ Servidor iniciado\")<br>" +
"})</code>\n" +
"            </div>\n" +
"\n" +
"            <h3>Classes e OOP</h3>\n" +
"            <div class=\"code-block\">\n" +
"                <code>класс Человек {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;функция конструктор(имя, возраст) {<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;это.имя = имя<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;это.возраст = возраст<br>" +
"&nbsp;&nbsp;&nbsp;&nbsp;}<br>" +
"}<br><br>" +
"пусть иван = новый Человек(\"Иван\", 30)<br>" +
"печать(иван.имя)</code>\n" +
"            </div>\n" +
"        </section>\n" +
"\n" +
"        <section id=\"biblioteca\">\n" +
"            <h2>Biblioteca Padrão (std)</h2>\n" +
"            <p>Trest inclui uma biblioteca padrão completa com 15 módulos prontos para usar:</p>\n" +
"            <ul>\n" +
"                <li><strong>Math:</strong> Funções matemáticas (sqrt, pow, abs, PI, E)</li>\n" +
"                <li><strong>String:</strong> Manipulação de strings (tamanho, maiúsculas, substituir)</li>\n" +
"                <li><strong>Array:</strong> Operações com arrays (adicionar, remover, ordenar)</li>\n" +
"                <li><strong>HTTP:</strong> Cliente e servidor HTTP completo</li>\n" +
"                <li><strong>Crypto:</strong> Criptografia e segurança (MD5, SHA256, AES)</li>\n" +
"                <li><strong>FileSystem:</strong> Operações de arquivo e diretório</li>\n" +
"                <li><strong>JSON:</strong> Parsing e stringificação de JSON</li>\n" +
"                <li><strong>Date:</strong> Manipulação de datas e timestamps</li>\n" +
"                <li><strong>Database:</strong> Conexão e modelos de banco de dados</li>\n" +
"                <li><strong>Async:</strong> Promises, timers e operações assíncronas</li>\n" +
"                <li><strong>RegEx:</strong> Expressões regulares</li>\n" +
"                <li><strong>Path:</strong> Manipulação de caminhos de arquivo</li>\n" +
"                <li><strong>Process:</strong> Variáveis de ambiente e sistema</li>\n" +
"                <li><strong>IO:</strong> Entrada e saída de dados</li>\n" +
"                <li><strong>GUI:</strong> Interface gráfica (em desenvolvimento)</li>\n" +
"            </ul>\n" +
"        </section>\n" +
"\n" +
"        <section id=\"links\">\n" +
"            <h2>Links Úteis</h2>\n" +
"            <div class=\"links-grid\">\n" +
"                <a href=\"https://trest-site.vercel.app/\" target=\"_blank\" class=\"link-card\">\n" +
"                    <h4>🌐 Site Oficial</h4>\n" +
"                    <p>Documentação completa e exemplos no site oficial do Trest</p>\n" +
"                </a>\n" +
"                <a href=\"https://www.npmjs.com/package/treste\" target=\"_blank\" class=\"link-card\">\n" +
"                    <h4>📦 NPM Package</h4>\n" +
"                    <p>Pacote oficial no NPM para instalação e uso</p>\n" +
"                </a>\n" +
"                <a href=\"https://socket.dev/npm/package/treste\" target=\"_blank\" class=\"link-card\">\n" +
"                    <h4>🔒 Socket Security</h4>\n" +
"                    <p>Análise de segurança do pacote Trest no Socket</p>\n" +
"                </a>\n" +
"            </div>\n" +
"            <p style=\"margin-top: 2rem; color: var(--text-secondary); font-size: 0.875rem;\">\n" +
"                Versão 2.4.9 • Licença MIT • Desenvolvido por PoktWeb\n" +
"            </p>\n" +
"        </section>\n" +
"    </main>\n" +
"</body>\n" +
"</html>"
}

# Criar servidor HTTP
пусть servidor = HTTP.создатьСервер()

# Rota principal
servidor.get("/", функция(запрос, ответ) {
    ответ.status(200)
    ответ.header("Content-Type", "text/html; charset=utf-8")
    ответ.send(obterHTMLCompleto())
})

# Rota de status (API JSON)
servidor.get("/api/status", функция(запрос, ответ) {
    пусть status = {
        servidor = "Trest",
        versao = "2.4.9",
        online = истина,
        linguagem = "Trest Language"
    }
    ответ.json(status)
})

# Iniciar servidor
servidor.listen(3000, функция() {
    печать("🚀 Site Trest iniciado com sucesso!")
    печать("🌐 Acesse: http://localhost:3000")
    печать("📊 Status API: http://localhost:3000/api/status")
})
