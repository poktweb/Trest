импорт * как HTTP измодуля "std/http"

# Função para gerar HTML completo do site
функция obterHTMLCompleto() {
    вернуть "<!DOCTYPE html>\n" +
"<html lang=\"pt-BR\">\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
