# Crypto Demo
печать("🔐 Crypto Library:")
пусть texto = "Trest Language é poderoso!"
пусть hash = Crypto.md5(texto)
печать("  MD5:", hash.substring(0, 20), "...")

пусть random = Crypto.случайныеБайты(8)
печать("  Bytes aleatórios:", random)
печать("")

# FileSystem Demo
печать("📁 FileSystem Library:")
пусть existe = FileSystem.существует("package.json")
печать("  package.json existe:", existe)
печать("")

# JSON Demo
печать("📄 JSON Library:")
