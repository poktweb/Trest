# Importar todas as bibliotecas
импорт * как Math измодуля "std/math"
импорт * как String измодуля "std/string"
импорт * как Array измодуля "std/array"
импорт * как IO измодуля "std/io"
импорт * как HTTP измодуля "std/http"
импорт * как Crypto измодуля "std/index"
импорт * как FileSystem измодуля "std/index"
импорт * как JSON измодуля "std/index"
импорт * как Date измодуля "std/index"

печать("📚 Módulos Importados com Sucesso!")
