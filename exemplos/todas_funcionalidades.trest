# Math Demo
печать("📊 Math Library:")
пусть resultado = Math.sqrt(16)
печать("  Math.sqrt(16) =", resultado)
печать("")

# Crypto Demo
печать("🔐 Crypto Library:")
пусть texto = "Trest é incrível!"
пусть hash = Crypto.md5(texto)
печать("  MD5 de 'Trest é incrível!':", hash)
печать("")

# FileSystem Demo
печать("📁 FileSystem Library:")
пусть existe = FileSystem.существует("package.json")
печать("  package.json existe:", existe)
печать("")

# JSON Demo
печать("📄 JSON Library:")
пусть obj = { nome = "PoktWeb", idade = 25 }
печать("  Objeto:", obj)
печать("")

