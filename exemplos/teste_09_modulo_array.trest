# Teste 9: Módulo Array
# Testa funções de manipulação de arrays

импорт * как Array измодуля "std/array"

печать("=== Teste 9: Módulo Array ===")

# Teste conforme documentação
пусть arr = [1, 2, 3]
Array.добавить(arr, 4)      # [1, 2, 3, 4]
печать("Após добавить: " + arr)

пусть обратный = Array.обратить([1, 2, 3])  # [3, 2, 1]
печать("Обратный: " + обратный)

пусть отсортированный = Array.отсортировать([3, 1, 2])  # [1, 2, 3]
печать("Отсортированный: " + отсортированный)

печать("✅ Teste 9: Módulo Array - PASSOU")
