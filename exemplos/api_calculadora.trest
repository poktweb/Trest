# 🧮 API Calculadora em Trest
# API REST que recebe dois números via query parameters e retorna operações matemáticas

импорт * как HTTP измодуля "std/http"
импорт * как Date измодуля "std/date"

печать("🧮 Iniciando API Calculadora...")
печать("")

# Configuração do servidor
пусть PORTA = 3001
пусть HOST = "localhost"

# Função para converter string para número
# Usa operações aritméticas para conversão (não depende de Number ou isNaN)
функция converterParaNumero(valor) {
    если (valor == нуль) {
        вернуть нуль
    }
    
    # Tentar converter usando operação aritmética
    # Se valor for string numérica, * 1 converte para número
    # Se não for numérico, resulta em NaN que será tratado
    попытаться {
        пусть numero = valor * 1
        
        # Verificar se é NaN comparando com ele mesmo (NaN != NaN)
        если (numero != numero) {
            вернуть нуль
        }
        
        вернуть numero
    } перехватить (erro) {
        вернуть нуль
    }
}

# Rota da API Calculadora
функция processarCalculadora(запрос, ответ) {
    печать("📄 Requisição: GET " + запрос.url)
    
    # Usar objeto query do request (já parseado pelo servidor HTTP)
    пусть queryObj = запрос.query
    
    # Extrair num1 e num2 diretamente do queryObj usando notação de ponto
    # Aceita tanto num1/num2 quanto calc1/calc2
    пусть num1Valor = нуль
    пусть num2Valor = нуль
    
    # Acessar propriedades do queryObj de forma segura
    если (queryObj != нуль) {
        # Tentar num1 primeiro, depois calc1
        если (queryObj.num1 != нуль) {
            num1Valor = queryObj.num1
        } иначе если (queryObj.calc1 != нуль) {
            num1Valor = queryObj.calc1
        }
        
        # Tentar num2 primeiro, depois calc2
        если (queryObj.num2 != нуль) {
            num2Valor = queryObj.num2
        } иначе если (queryObj.calc2 != нуль) {
            num2Valor = queryObj.calc2
        }
    }
    
    # Converter para números
    пусть num1 = converterParaNumero(num1Valor)
    пусть num2 = converterParaNumero(num2Valor)
    
    # Validar números
    если (num1 == нуль || num2 == нуль) {
        ответ.status(400)
        ответ.json({
            erro = истина,
            mensagem = "Parâmetros inválidos. Use: /calc?num1=2&num2=2 ou /calc?calc1=2&calc2=2",
            exemplo = "http://localhost:3001/calc?num1=10&num2=5"
        })
    } иначе {
    
    # Realizar operações matemáticas
    пусть soma = num1 + num2
    пусть subtracao = num1 - num2
    пусть multiplicacao = num1 * num2
    пусть divisao = нуль
    пусть divisaoErro = ""
    
    # Verificar divisão por zero
    если (num2 != 0) {
        divisao = num1 / num2
    } иначе {
        divisaoErro = "Divisão por zero não é permitida"
    }
    
    # Preparar resposta JSON
    # Se houver erro na divisão, incluir aviso no objeto
    пусть resultado = {
        sucesso = истина,
        entrada = {
            num1 = num1,
            num2 = num2
        },
        operacoes = {
            soma = soma,
            subtracao = subtracao,
            multiplicacao = multiplicacao,
            divisao = divisao,
            divisaoErro = divisaoErro
        },
        timestamp = Date.timestamp(),
        aviso = divisaoErro != "" ? divisaoErro : ""
    }
    
    # Enviar resposta JSON
    ответ.status(200)
    ответ.json(resultado)
    }
}

# Criar servidor HTTP
пусть servidor = HTTP.создатьСервер()

# Rota principal - Documentação
servidor.get("/", функция(запрос, ответ) {
    печать("📄 Requisição: GET /")
    ответ.status(200)
    ответ.send("<!DOCTYPE html>\n" +
"<html lang=\"pt-BR\">\n" +
"<head>\n" +
"    <meta charset=\"UTF-8\">\n" +
"    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n" +
"    <title>API Calculadora - Trest</title>\n" +
"    <style>\n" +
"        * { margin: 0; padding: 0; box-sizing: border-box; }\n" +
"        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 40px 20px; }\n" +
"        .container { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; max-width: 800px; margin: 0 auto; }\n" +
"        h1 { color: #667eea; margin-bottom: 20px; font-size: 2.5em; text-align: center; }\n" +
"        .endpoint { background: #f8f9fa; border-left: 4px solid #667eea; padding: 20px; margin: 20px 0; border-radius: 5px; }\n" +
"        .method { display: inline-block; background: #667eea; color: white; padding: 5px 15px; border-radius: 5px; font-weight: bold; margin-right: 10px; }\n" +
"        .url { font-family: 'Courier New', monospace; font-size: 1.1em; color: #333; margin: 10px 0; }\n" +
"        .example { background: #e9ecef; padding: 15px; border-radius: 5px; margin: 10px 0; font-family: 'Courier New', monospace; overflow-x: auto; }\n" +
"        code { background: #f8f9fa; padding: 2px 6px; border-radius: 3px; font-family: 'Courier New', monospace; }\n" +
"    </style>\n" +
"</head>\n" +
"<body>\n" +
"    <div class=\"container\">\n" +
"        <h1>🧮 API Calculadora</h1>\n" +
"        <p style=\"text-align: center; color: #666; margin-bottom: 30px;\">API REST para operações matemáticas básicas</p>\n" +
"        \n" +
"        <div class=\"endpoint\">\n" +
"            <span class=\"method\">GET</span>\n" +
"            <span class=\"url\">/calc</span>\n" +
"            <p style=\"margin-top: 10px; color: #666;\">Realiza operações matemáticas (soma, subtração, multiplicação e divisão)</p>\n" +
"            <p style=\"margin-top: 10px;\"><strong>Parâmetros:</strong></p>\n" +
"            <ul style=\"margin-left: 20px; color: #666;\">\n" +
"                <li><code>num1</code> ou <code>calc1</code> - Primeiro número</li>\n" +
"                <li><code>num2</code> ou <code>calc2</code> - Segundo número</li>\n" +
"            </ul>\n" +
"            <p style=\"margin-top: 15px;\"><strong>Exemplo:</strong></p>\n" +
"            <div class=\"example\">\n" +
"                http://localhost:3001/calc?num1=10&num2=5<br>\n" +
"                ou<br>\n" +
"                http://localhost:3001/calc?calc1=10&calc2=5\n" +
"            </div>\n" +
"            <p style=\"margin-top: 15px;\"><strong>Resposta JSON:</strong></p>\n" +
"            <div class=\"example\">\n" +
"                {<br>\n" +
"                &nbsp;&nbsp;\"sucesso\": true,<br>\n" +
"                &nbsp;&nbsp;\"entrada\": { \"num1\": 10, \"num2\": 5 },<br>\n" +
"                &nbsp;&nbsp;\"operacoes\": {<br>\n" +
"                &nbsp;&nbsp;&nbsp;&nbsp;\"soma\": 15,<br>\n" +
"                &nbsp;&nbsp;&nbsp;&nbsp;\"subtracao\": 5,<br>\n" +
"                &nbsp;&nbsp;&nbsp;&nbsp;\"multiplicacao\": 50,<br>\n" +
"                &nbsp;&nbsp;&nbsp;&nbsp;\"divisao\": 2<br>\n" +
"                &nbsp;&nbsp;}<br>\n" +
"                }<br>\n" +
"            </div>\n" +
"        </div>\n" +
"        \n" +
"        <div style=\"text-align: center; margin-top: 30px; color: #999; font-size: 0.9em;\">\n" +
"            <p>Feito com ❤️ usando Trest Language v2.4.7</p>\n" +
"        </div>\n" +
"    </div>\n" +
"</body>\n" +
"</html>")
})

# Rota da API Calculadora
servidor.get("/calc", processarCalculadora)

# Rota 404
# Rota 404 - Catch-all (qualquer rota não encontrada)
servidor.use("*", функция(запрос, ответ) {
    печать("❌ Requisição não encontrada: " + запрос.method + " " + запрос.url)
    ответ.status(404)
    ответ.json({
        erro = истина,
        mensagem = "Rota não encontrada",
        metodo = запрос.method,
        caminho = запрос.pathname,
        rotas_disponiveis = ["/", "/calc"]
    })
})

# Iniciar servidor
servidor.listen(PORTA, функция() {
    печать("")
    печать("✅ API Calculadora iniciada com sucesso!")
    печать("")
    печать("🌐 Acesse: http://" + HOST + ":" + PORTA)
    печать("")
    печать("📋 Rotas disponíveis:")
    печать("   • GET  /              - Documentação da API")
    печать("   • GET  /calc?num1=X&num2=Y  - Calcular operações")
    печать("   • GET  /calc?calc1=X&calc2=Y  - Calcular operações (alternativo)")
    печать("")
    печать("💡 Exemplo:")
    печать("   http://localhost:3001/calc?num1=10&num2=5")
    печать("")
    печать("💡 Pressione Ctrl+C para parar o servidor")
    печать("")
})
