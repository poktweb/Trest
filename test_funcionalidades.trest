# ============================================
# TESTE 1: Variáveis e Tipos
# ============================================
печать("📝 TESTE 1: Variáveis e Tipos")
пусть numero = 42
пусть texto = "Привет"
пусть booleano = истина
пусть vazio = нуль
печать("  ✅ Variáveis:", numero, texto, booleano, vazio)
печать("")

# ============================================
# TESTE 2: Operadores Aritméticos
# ============================================
печать("🔢 TESTE 2: Operadores Aritméticos")
пусть a = 10
пусть b = 5
печать("  a + b =", a + b)
печать("  a - b =", a - b)
печать("  a * b =", a * b)
печать("  a / b =", a / b)
печать("  a % b =", a % b)
печать("  a ** 2 =", a ** 2)
печать("")

# ============================================
# TESTE 3: Operadores de Comparação
# ============================================
печать("⚖️ TESTE 3: Operadores de Comparação")
печать("  10 == 10:", 10 == 10)
печать("  10 != 5:", 10 != 5)
печать("  10 < 20:", 10 < 20)
печать("  10 > 5:", 10 > 5)
печать("  10 <= 10:", 10 <= 10)
печать("  10 >= 10:", 10 >= 10)
печать("")

# ============================================
# TESTE 4: Operadores Lógicos
# ============================================
печать("🔀 TESTE 4: Operadores Lógicos")
печать("  истина && истина:", истина && истина)
печать("  истина || ложь:", истина || ложь)
печать("  !ложь:", !ложь)
печать("")

# ============================================
# TESTE 5: Condicionais
# ============================================
печать("🔀 TESTE 5: Condicionais")
пусть idade = 25
если (idade >= 18) {
    печать("  ✅ Maior de idade")
} иначе {
    печать("  ❌ Menor de idade")
}
печать("")

# ============================================
# TESTE 6: Switch/Case
# ============================================
печать("🔄 TESTE 6: Switch/Case")
пусть dia = 1
переключатель (dia) {
    случай 1:
        печать("  ✅ Segunda-feira")
        прервать
    случай 2:
        печать("  Terça-feira")
        прервать
    поумолчанию:
        печать("  Outro dia")
}
печать("")

# ============================================
# TESTE 7: Loops While
# ============================================
печать("🔄 TESTE 7: Loop While")
пусть i = 0
пока (i < 3) {
    печать("  Contador:", i)
    i = i + 1
}
печать("")

# ============================================
# TESTE 8: Loops For
# ============================================
печать("🔄 TESTE 8: Loop For")
для (пусть j = 0; j < 3; j = j + 1) {
    печать("  For contador:", j)
}
печать("")

