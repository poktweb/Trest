# ============================================
# TESTE 22: Recursão
# ============================================
печать("🔄 TESTE 22: Recursão")
функция fatorial(n) {
    если (n <= 1) {
        вернуть 1
    }
    вернуть n * fatorial(n - 1)
}
печать("  fatorial(5) =", fatorial(5))
печать("")

